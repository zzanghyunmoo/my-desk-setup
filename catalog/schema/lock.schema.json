{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zzanghyunmoo/my-desk-setup/catalog/schema/lock.schema.json",
  "title": "My Desk Setup Version Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "versions"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "versions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "source", "provenance"],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
