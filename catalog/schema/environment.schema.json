{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zzanghyunmoo/my-desk-setup/catalog/schema/environment.schema.json",
  "title": "My Desk Setup Environment Intent Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "provides",
        "dependencies",
        "version_policy",
        "verification",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "agent",
            "build",
            "cli",
            "container",
            "editor",
            "gui",
            "language",
            "platform",
            "terminal"
          ]
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "version_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["pinned", "manager", "manual"]
            },
            "lock_key": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "functional": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "macos-host",
            "windows-host",
            "wsl-guest",
            "lima-guest"
          ],
          "properties": {
            "macos-host": {
              "$ref": "#/$defs/target"
            },
            "windows-host": {
              "$ref": "#/$defs/target"
            },
            "wsl-guest": {
              "$ref": "#/$defs/target"
            },
            "lima-guest": {
              "$ref": "#/$defs/target"
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["supported", "unsupported", "action-required"]
        },
        "installer": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
